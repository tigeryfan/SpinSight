{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "allowJs": true, "checkJs": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "resolveJsonModule": true,
    "skipLibCheck": true, "noEmit": true, "types": ["vite/client", "bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
